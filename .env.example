DOUBAO_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark-cn-beijing.bytedance.net/api/v3
ARK_MODEL=ep-20260711182023-xgdw7
ARK_REQUEST_TIMEOUT_MS=120000
# Education document import uses the public Ark API and keeps credentials on
# the server. Leave the key empty in source control and set it only in .env.
ARK_EDUCATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EDUCATION_VISION_MODEL=doubao-seed-2-1-turbo-260628
ARK_EDUCATION_TEXT_MODEL=deepseek-v4-flash-260425
ARK_EDUCATION_EMBEDDING_MODEL=doubao-embedding-vision-250615
# Teaching-video media generation. These clients reuse the server-only
# ARK_API_KEY above. Never copy the key into browser code or task payloads.
ARK_MEDIA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDREAM_MODEL=doubao-seedream-5-0-260128
ARK_SEEDANCE_MODEL=doubao-seedance-2-5-260628
ARK_MEDIA_REQUEST_TIMEOUT_MS=120000
# Comma-separated provider output host suffixes permitted for local transfer.
ARK_MEDIA_OUTPUT_HOSTS=volces.com,ivolces.com,volccdn.com
# Video projects, scenes, provider tasks and local media remain recoverable
# after leaving the page. Leave command values empty to use bundled/system
# discovery; explicit values may be absolute executable paths.
EDUCATION_VIDEO_STORAGE_DIR=data/education-video-media
EDUCATION_VIDEO_POLL_INTERVAL_MS=10000
EDUCATION_VIDEO_MAX_POLL_ERRORS=12
EDUCATION_VIDEO_SOFFICE_COMMAND=
EDUCATION_VIDEO_FFMPEG_COMMAND=
# Maximum combined bytes of locally archived textbook images sent to one
# Seedream request. Image bytes are never written to SQLite or returned by API.
EDUCATION_VIDEO_REFERENCE_IMAGE_BYTES=33554432
# Application-owned Pi learning agent. It reuses ARK_API_KEY and the vision
# model above; no external Agent-platform endpoint or key is required.
ARK_PI_LEARNING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PI_LEARNING_MODEL=doubao-seed-2-1-turbo-260628
ARK_PI_LEARNING_TIMEOUT_MS=300000
# `auto` image routing asks the multimodal model to choose solve or grade.
# Below this confidence it returns a two-choice clarification and calls neither.
EDUCATION_IMAGE_TASK_CONFIDENCE_THRESHOLD=0.8
# Reasoning-model structured output includes hidden reasoning in this budget;
# use a wider deadline together with small semantic page batches.
ARK_MODEL_REQUEST_TIMEOUT_MS=600000
ARK_MODEL_MAX_RETRIES=2
EDUCATION_IMPORT_MAX_PAGES=300
EDUCATION_IMPORT_MAX_VISION_PAGES=300
EDUCATION_IMPORT_SEMANTIC_BATCH_PAGES=2
EDUCATION_IMPORT_MAX_SEMANTIC_BATCHES=50
# Authoritative application data. The default file is ignored by Git and all
# personal rows remain tenant/student scoped. Demo seeds are explicitly marked.
EDUCATION_DATA_DB_PATH=data/education-runtime/education.sqlite
EDUCATION_DATA_TENANT_ID=local-demo
EDUCATION_DATA_SEED_DEMO=true
# At least 32 random bytes. It signs server grading receipts before real
# mastery evidence is written; never expose this value to browser code.
EDUCATION_MASTERY_RECEIPT_SECRET=
# Reviewed education knowledge publication and retrieval. Credentials stay in
# the local .env only. Non-loopback endpoints must use TLS.
EDUCATION_KNOWLEDGE_TENANT_ID=local-demo
EDUCATION_KNOWLEDGE_PRINCIPAL_ID=local-reviewer
EDUCATION_KNOWLEDGE_NAMESPACE=education
EDUCATION_KNOWLEDGE_PUBLICATION_DIR=data/education-knowledge-publications
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_EDUCATION_COLLECTION=education_knowledge_v1
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_SPARSE_MODIFIER=idf
QDRANT_REQUEST_TIMEOUT_MS=30000
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
PORT=3042

# Server-private settings edited in the Settings page are persisted here with
# file mode 0600. The directory is ignored by Git. Environment values remain
# the fallback until a field receives an explicit saved override.
EDUCATION_RUNTIME_SETTINGS_PATH=data/education-runtime/runtime-settings.json
# Optional per-capability credentials; each falls back to ARK_API_KEY.
ARK_PI_LEARNING_API_KEY=
ARK_EDUCATION_VISION_API_KEY=
ARK_EDUCATION_EMBEDDING_API_KEY=
ARK_SEEDREAM_API_KEY=
ARK_SEEDANCE_API_KEY=
# External Agent proxy is off by default. When enabled, every non-voice teacher
# turn is routed through the configured server-side adapter.
EDUCATION_AGENT_PROXY_ENABLED=false
EDUCATION_AGENT_PROXY_ENDPOINT=
EDUCATION_AGENT_PROXY_API_KEY=
EDUCATION_AGENT_PROXY_TIMEOUT_MS=300000

# Volcengine AskEcho education Bot: online search and homework marking.
# Create a dedicated "联网问答Agent" API Key and keep it server-side.
# Console account names, release tokens and AK/SK values are not Bearer API keys.
# Exact server-only value sent as `Authorization: Bearer ...` (preferred).
VOLC_EDUCATION_BOT_BEARER_TOKEN=
# Compatibility variables for existing deployments. When both are present,
# explicitly select `api_key` or `api_token` with BEARER_SOURCE.
VOLC_EDUCATION_BOT_BEARER_SOURCE=
VOLC_EDUCATION_BOT_API_KEY=
VOLC_EDUCATION_BOT_API_TOKEN=
VOLC_EDUCATION_BOT_ID=7681229989123081734
VOLC_EDUCATION_BOT_SERVICE_NAME=ask_echo
VOLC_EDUCATION_BOT_BASE_URL=https://open.feedcoopapi.com/agent_api/agent
VOLC_EDUCATION_BOT_TIMEOUT_MS=120000
VOLC_EDUCATION_BOT_CONFIG_PROBE_TIMEOUT_MS=15000
VOLC_EDUCATION_BOT_CONFIG_PROBE_CACHE_TTL_MS=300000
VOLC_EDUCATION_BOT_MARK_POLL_INTERVAL_MS=2200
VOLC_EDUCATION_BOT_MARK_TIMEOUT_MS=120000
